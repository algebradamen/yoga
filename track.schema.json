{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "track.schema.json",
  "title": "Yoga Track",
  "description": "A yoga session track with a sequence of poses",
  "type": "object",
  "required": ["Name", "Duration", "Poses"],
  "properties": {
    "Name": {
      "type": "string",
      "description": "The name of the track"
    },
    "Duration": {
      "type": "integer",
      "minimum": 1,
      "description": "Total duration of the track in minutes"
    },
    "Description": {
      "type": "string",
      "description": "Markdown-formatted description of the track"
    },
    "Poses": {
      "type": "array",
      "description": "Ordered list of poses in the track",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Pose"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Pose": {
      "type": "object",
      "required": ["Name"],
      "properties": {
        "Name": {
          "type": "string",
          "description": "The name of the pose"
        },
        "Duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Duration to hold the pose in minutes"
        },
        "Description": {
          "type": "string",
          "description": "Markdown-formatted description and instructions for the pose"
        },
        "Sensation": {
          "type": "array",
          "description": "Physical or emotional sensations of the pose",
          "items": { "type": "string" },
          "minItems": 1
        },
        "Meridians": {
          "type": "array",
          "description": "List of meridians activated by the pose",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "Instructions": {
          "type": "string",
          "description": "Step-by-step instructions for entering the pose"
        },
        "Counterpose": {
          "type": "object",
          "description": "A counterpose to perform after this pose",
          "required": ["Name"],
          "properties": {
            "Name": { "type": "string" },
            "Description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "Transition": {
          "type": "string",
          "description": "How to transition into this pose"
        },
        "Adjustments": {
          "type": "string",
          "description": "Modifications or props for accessibility"
        },
        "Alternatives": {
          "type": "array",
          "description": "Alternative versions of the pose",
          "items": { "$ref": "#/$defs/Alternative" },
          "minItems": 0
        },
        "Rebound": {
          "$ref": "#/$defs/Rebound"
        }
      },
      "additionalProperties": false
    },
    "Rebound": {
      "type": "object",
      "required": ["Description", "Duration"],
      "description": "Rebound/integration movement after the pose",
      "properties": {
        "Description": {
          "type": "string",
          "description": "What to do during the rebound"
        },
        "Duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Duration of the rebound in minutes"
        }
      },
      "additionalProperties": false
    },
    "Alternative": {
      "type": "object",
      "required": ["Name"],
      "description": "An alternative version of the pose",
      "properties": {
        "Name": {
          "type": "string",
          "description": "Name of the alternative pose"
        },
        "Description": {
          "type": "string",
          "description": "Markdown-formatted description of the alternative"
        }
      },
      "additionalProperties": false
    }
  }
}

